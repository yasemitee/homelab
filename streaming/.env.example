# Credentials for your Private Internet Access subscription.
# Used by gluetun to open the VPN tunnel nzbget downloads through.
OPENVPN_USER=your PIA username
OPENVPN_PASSWORD=your PIA password

# Absolute path on the host where movies and TV shows are kept.
# Mounted as /data in jellyfin/nzbget/sonarr/radarr: make sure there's plenty of space.
MEDIA_PATH=/path/to/your/media
